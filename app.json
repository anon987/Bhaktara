{
  "expo": {
    "name": "Bhaktara",
    "slug": "bhaktara",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhaktara.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FBF7EF"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.bhaktara.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/analytics",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/app-check",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false
        }
      ],
      "./plugins/withPictureInPicture",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "भक्तारा आपकी फ़ोटो खोलेगा, ताकि आप अपनी प्रोफ़ाइल फ़ोटो चुन सकें। / Bhaktara opens your photos so you can choose your profile photo.",
          "cameraPermission": "भक्तारा कैमरा खोलेगा, ताकि आप अपनी प्रोफ़ाइल फ़ोटो खींच सकें। / Bhaktara opens the camera so you can take your profile photo.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#FF9933",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#FFFFFF",
            "cropBackButtonIconColor": "#FFFFFF",
            "cropBackgroundColor": "#3A0F0C"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "bhaktara",
    "splash": {
      "backgroundColor": "#FBF7EF"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
  }
}
