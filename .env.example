# Default fixture mode does not connect to Firebase.
EXPO_PUBLIC_BACKEND_MODE=fixture
# For local Firebase integration, set mode to emulator and restart Metro with
# --clear (Metro caches inlined EXPO_PUBLIC_* values between modes).
# Physical phone: reverse ports 8080 and 9099 with adb; keep 127.0.0.1.
# Android emulator: use 10.0.2.2. No API keys needed for demo-bhaktara.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Public CDN origin for the R2 media bucket (no trailing slash). Unset keeps
# bundled placeholder art. Example: https://media-dev.example.com
EXPO_PUBLIC_MEDIA_BASE_URL=

# R2 operator credentials for `npm run media:publish` go in .env.r2 (Git-ignored),
# never here and never with an EXPO_PUBLIC_ prefix. See docs/MEDIA_R2.md.
