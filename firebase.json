{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "test",
        "build.mjs",
        "tsconfig.json",
        "*.log",
        ".env.local",
        ".secret.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  },
  "react-native": {
    "analytics_auto_collection_enabled": false,
    "google_analytics_adid_collection_enabled": false,
    "google_analytics_ssaid_collection_enabled": false,
    "google_analytics_automatic_screen_reporting_enabled": false,
    "google_analytics_default_allow_analytics_storage": false,
    "google_analytics_default_allow_ad_storage": false,
    "google_analytics_default_allow_ad_user_data": false,
    "google_analytics_default_allow_ad_personalization_signals": false,
    "crashlytics_auto_collection_enabled": false,
    "crashlytics_debug_enabled": false,
    "app_check_token_auto_refresh": true
  }
}
