# Admin app settings (Vite). Copy to .env.local (development) or
# .env.production.local (build); both are Git-ignored. Defaults need no file.

# Emulator mode (default): talks to `npm run emulators:cms` on 127.0.0.1.
# The project ID must start with demo- so nothing can reach a real project.
# VITE_USE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=demo-bhaktara
# VITE_EMULATOR_HOST=127.0.0.1
# VITE_AUTH_EMULATOR_PORT=9099
# VITE_FIRESTORE_EMULATOR_PORT=8080
# VITE_FUNCTIONS_EMULATOR_PORT=5001

# Real project (only once Functions are deployed, which needs Blaze):
# VITE_USE_EMULATORS=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Region of the CMS callables (functions/src/index.ts).
# VITE_FUNCTIONS_REGION=asia-south1
