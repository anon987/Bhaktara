{
  "name": "bhaktara",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "^26.4.0",
    "@react-native-firebase/remote-config": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "firebase": "^12.19.0",
    "lucide-react-native": "^1.51.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.tsx tests",
    "build:android": "cd android && ./gradlew assembleDebug",
    "export:android": "expo export --platform android --clear",
    "export:web": "expo export --platform web --clear",
    "emulators": "firebase emulators:start --project demo-bhaktara --only auth,firestore",
    "firebase:android-config": "firebase apps:sdkconfig ANDROID 1:83349652654:android:bd2a4c399e1d15da2f993f --project dev --out google-services.json",
    "seed:emulators": "tsx scripts/emulator/seed.ts",
    "seed:dev": "tsx scripts/emulator/seed.ts --project dev",
    "seed:progression:dev": "tsx scripts/progression/seed.ts --project dev",
    "content:import": "tsx --env-file-if-exists=.env.r2 scripts/content/import.ts",
    "media:publish": "tsx --env-file-if-exists=.env.r2 scripts/media/publish.ts",
    "progress": "tsx scripts/progress/generate.ts",
    "progress:check": "tsx scripts/progress/generate.ts --check",
    "test:emulators": "firebase emulators:exec --project demo-bhaktara --only auth,firestore \"tsx --test --test-concurrency=1 emulator-tests/*.test.ts\"",
    "functions:install": "npm --prefix functions ci",
    "functions:build": "npm --prefix functions run build",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "test:functions": "npm run functions:build && npm --prefix functions test && MEDIA_PROCESSOR_URL=http://127.0.0.1:5098 MEDIA_PROCESSOR_DEV_TOKEN=emulator-only-processor-token sh scripts/firebase-emulators.sh emulators:exec --project demo-bhaktara --only auth,firestore,functions \"tsx --test --test-concurrency=1 functions/test/*.test.ts\"",
    "processor:install": "npm --prefix services/media-processor ci",
    "processor:typecheck": "npm --prefix services/media-processor run typecheck",
    "processor:build": "npm --prefix services/media-processor run build",
    "test:processor": "npm --prefix services/media-processor test",
    "emulators:cms": "npm run functions:build && sh scripts/firebase-emulators.sh emulators:start --project demo-bhaktara --only auth,firestore,functions",
    "admin:grant-role": "tsx scripts/admin/grant-role.ts",
    "admin:install": "npm --prefix admin ci",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "admin:typecheck": "npm --prefix admin run typecheck",
    "admin:test": "npm --prefix admin test",
    "admin:check": "npm run admin:typecheck && npm run admin:test && npm run admin:build",
    "admin:smoke": "npm run functions:build && sh scripts/firebase-emulators.sh emulators:exec --project demo-bhaktara --only auth,firestore,functions \"tsx admin/e2e/emulator-smoke.ts\""
  },
  "private": true
}
