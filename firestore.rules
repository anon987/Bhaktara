rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }
    function owner(uid) { return authenticated() && request.auth.uid == uid; }
    function bounded(maximum) { return request.query.limit != null && request.query.limit <= maximum; }
    function signedIn() {
      return authenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /content/{id} {
      allow get: if authenticated() && resource.data.status == 'PUBLISHED';
      allow list: if authenticated() && resource.data.status == 'PUBLISHED' && bounded(30);
    }
    match /deities/{id} {
      allow get: if authenticated() && resource.data.isActive == true;
      allow list: if authenticated() && resource.data.isActive == true && bounded(30);
    }
    match /banners/{id} {
      allow get: if authenticated() && resource.data.isActive == true;
      allow list: if authenticated() && resource.data.isActive == true && bounded(10);
    }
    // Precomputed Home feed (doc 06 §3): one server-written doc per language.
    // Single-doc gets only; a missing doc reads as absent so the app can show
    // its empty state. The CMS source (homeLayout) stays admin-only.
    match /homeFeeds/{language} {
      allow get: if authenticated() && language in ['hi', 'en']
        && (resource == null || resource.data.isPublished == true);
    }
    match /users/{uid} {
      allow get: if owner(uid);
      // Server creates the profile. Clients may only update these preferences.
      // displayName and photoKey change only through updateProfile (profanity
      // filter, uploaded-photo check, league copies), timezone through
      // setTimezone; merge markers and limits are server fields.
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'language', 'mandirDeityId', 'notificationPreferences'
        ])
        && request.resource.data.language in ['hi', 'en']
        && (request.resource.data.mandirDeityId == null ||
          (request.resource.data.mandirDeityId is string && request.resource.data.mandirDeityId.size() <= 100))
        && request.resource.data.notificationPreferences.keys().hasAll(['dailyReminder', 'reminderTime', 'newContent', 'festivals', 'league'])
        && request.resource.data.notificationPreferences.keys().hasOnly(['dailyReminder', 'reminderTime', 'newContent', 'festivals', 'league'])
        && request.resource.data.notificationPreferences.dailyReminder is bool
        && request.resource.data.notificationPreferences.reminderTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.notificationPreferences.newContent is bool
        && request.resource.data.notificationPreferences.festivals is bool
        && request.resource.data.notificationPreferences.league is bool;
      match /favorites/{contentId} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['contentId', 'type', 'createdAt'])
          && request.resource.data.contentId == contentId
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/content/$(contentId)).data.status == 'PUBLISHED'
          && request.resource.data.type == get(/databases/$(database)/documents/content/$(contentId)).data.type;
        allow delete: if owner(uid);
      }
      match /days/{day} { allow read: if owner(uid); }
      match /sessions/{session} { allow read: if owner(uid); }
      match /badges/{badge} { allow read: if owner(uid); }
    }
    match /userStats/{uid} { allow get: if owner(uid); }
    match /entitlements/{uid} { allow get: if owner(uid); }
    // Doc IDs are {uid}_{challengeId}_{periodKey}, so the app can get its own
    // progress by ID, including challenges it has not started (absent doc).
    match /userChallenges/{id} {
      allow get: if authenticated() && id.split('_')[0] == request.auth.uid;
      allow list: if authenticated() && resource.data.uid == request.auth.uid && bounded(50);
    }
    // Habit-layer catalog (doc 06 §5): active challenges and badges, and the
    // gamification and Sadhana config the app displays. Admin-written only.
    match /challenges/{id} {
      allow get: if authenticated() && resource.data.isActive == true;
      allow list: if authenticated() && resource.data.isActive == true && bounded(50);
    }
    match /badges/{id} {
      allow get: if authenticated() && resource.data.isActive == true;
      allow list: if authenticated() && resource.data.isActive == true && bounded(50);
    }
    match /appConfig/{id} {
      allow get: if authenticated() && id in ['gamification', 'sadhana', 'visuals'];
    }
    // Mandir decor for the Prayer screen (temples, lights, bells, flowers):
    // active offerings only. Start/end windows are applied by the app.
    match /mandirOfferings/{id} {
      allow get: if authenticated() && resource.data.isActive == true;
      allow list: if authenticated() && resource.data.isActive == true && bounded(200);
    }
    match /leagueCohorts/{id} {
      allow get: if signedIn();
      allow list: if signedIn() && bounded(30);
    }
    match /leagueMembers/{id} {
      allow get: if signedIn();
      allow list: if signedIn() && bounded(30);
    }
    // ---- Admin CMS reads (doc 09 §15). Roles come only from the `role` custom
    // claim set by setAdminRole or scripts/admin/grant-role.ts; guests never
    // qualify. Reads only: every CMS write goes through Cloud Functions, which
    // also write the audit log. Keep in sync with `permissions` in
    // src/domain/cms.ts. Rules combine with OR, so these blocks only widen
    // access for staff and leave the public rules above unchanged.
    function hasRole(roles) {
      return signedIn() && request.auth.token.get('role', '') in roles;
    }
    function contentStaff() { return hasRole(['SUPER_ADMIN', 'CONTENT_ADMIN', 'EDITOR']); }
    function contentAdmin() { return hasRole(['SUPER_ADMIN', 'CONTENT_ADMIN']); }
    match /content/{id} {
      allow get: if contentStaff();
      allow list: if contentStaff() && bounded(100);
    }
    match /contentPrivate/{id} {
      allow get: if contentStaff();
      allow list: if contentStaff() && bounded(100);
    }
    match /banners/{id} {
      allow get: if contentAdmin();
      allow list: if contentAdmin() && bounded(100);
    }
    // Home manager source layouts (one per language); writes go through
    // updateHomeLayout so each one is validated, audited and rebuilt.
    match /homeLayout/{language} {
      allow get: if contentAdmin() && language in ['hi', 'en'];
    }
    match /auditLogs/{id} {
      allow get: if contentAdmin();
      allow list: if contentAdmin() && bounded(100);
    }

    // ---- Admin panel v2 reads (keep in sync with src/domain/cms.ts). Writes
    // go through the catalogue, config and asset callables (audited).
    function catalogStaff() { return hasRole(['SUPER_ADMIN', 'CONTENT_ADMIN', 'EDITOR', 'ANALYST']); }
    function configStaff() { return hasRole(['SUPER_ADMIN', 'CONTENT_ADMIN', 'ANALYST']); }
    match /deities/{id} {
      allow get: if catalogStaff();
      allow list: if catalogStaff() && bounded(200);
    }
    match /categories/{id} {
      allow get: if catalogStaff();
      allow list: if catalogStaff() && bounded(200);
    }
    match /collections/{id} {
      allow get: if catalogStaff();
      allow list: if catalogStaff() && bounded(200);
    }
    match /challenges/{id} {
      allow get: if catalogStaff();
      allow list: if catalogStaff() && bounded(200);
    }
    match /badges/{id} {
      allow get: if catalogStaff();
      allow list: if catalogStaff() && bounded(200);
    }
    match /festivals/{id} {
      allow get: if catalogStaff();
      allow list: if catalogStaff() && bounded(200);
    }
    match /mandirOfferings/{id} {
      allow get: if catalogStaff();
      allow list: if catalogStaff() && bounded(200);
    }
    match /appConfig/{id} {
      allow get: if configStaff();
      match /versions/{version} {
        allow get: if configStaff();
        allow list: if configStaff() && bounded(50);
      }
    }
    match /mediaAssets/{id} {
      allow get: if contentStaff();
      allow list: if contentStaff() && bounded(100);
    }

    // CMS, private provenance, ledgers, merges and unimplemented collections
    // are denied to client SDKs. Trusted server code uses the Admin SDK.
    match /{document=**} { allow read, write: if false; }
  }
}
